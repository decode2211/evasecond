# Copy this file to .env (or export these as real environment variables)
# before running the backend locally.

# Required. Postgres connection string.
# Local (docker-compose, see ../docker-compose.yml): postgres://postgres:postgres@localhost:5433/eva2?sslmode=disable
# Neon (production): postgres://user:pass@ep-xxxx.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=postgres://postgres:postgres@localhost:5433/eva2?sslmode=disable

# Port the HTTP server listens on.
PORT=8080

# Comma-separated list of frontend origins allowed to call this API from a
# browser. Include your local Vite dev server and your deployed frontend.
CORS_ORIGINS=http://localhost:5173

# How long, in seconds, each window's playlist cycle lasts before it
# restarts from item 1. The assignment fixes this at 5 hours.
CYCLE_SECONDS=18000

# How many milliseconds in the future a sync event's start time is set, so
# every connected browser has time to receive it before it begins.
SYNC_LEAD_MS=1500

# Insert placeholder demo windows/media the first time the server runs
# against an empty database.
SEED_ON_START=true
